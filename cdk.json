                "creative_optimization": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
                "trend_analysis": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
                "fact_checking": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
                "player_targeting": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
                "player_segmentation": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
                "acquisition_optimization": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
