            "tables": [
                {
                    "name": "players",
                    "s3Prefix": "athena/players/",
                    "columns": [
                        { "name": "player_id", "type": "string" },
                        { "name": "username", "type": "string" },
                        { "name": "account_created", "type": "string" },
                        { "name": "player_level", "type": "int" },
                        { "name": "arena_rank", "type": "int" },
                        { "name": "combat_power", "type": "bigint" },
                        { "name": "guild_id", "type": "string" },
                        { "name": "country", "type": "string" },
                        { "name": "platform", "type": "string" },
                        { "name": "segment", "type": "string" },
                        { "name": "last_login", "type": "string" },
                        { "name": "characters_owned", "type": "int" },
                        { "name": "legendary_heroes_owned", "type": "int" }
                    ]
                },
